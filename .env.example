APP_NAME=CallSaul Voice Agent
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=callsaul

# Added in later implementation steps
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_TTS_MODEL=flux-alexis-en
DEEPGRAM_TTS_SAMPLE_RATE=24000

# normal, slow, fail, or cycle
FAKE_BACKEND_MODE=cycle
FAKE_BACKEND_SLOW_SECONDS=6
FAKE_BACKEND_PROGRESS_SECONDS=2.5
